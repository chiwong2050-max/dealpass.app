# =============================================================================
# DealPass - environment configuration
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is git-ignored and must NEVER be committed.
# =============================================================================

# --- Server -----------------------------------------------------------------
# Port the single Node process (Express API + built frontend) listens on.
PORT=3000

# --- Public site URL --------------------------------------------------------
# Drives canonical links, sitemap.xml and robots.txt. No trailing slash.
SITE_URL=https://your-domain.example

# --- Database (SQLite, standalone - no hosted/paid DB required) -------------
# The relative path is resolved from backend/prisma/schema.prisma.
DATABASE_URL="file:./data/dealpass.db"

# --- Auth -------------------------------------------------------------------
# REQUIRED. Generate a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-long-random-secret

# --- Optional paid third-party services (leave empty to keep disabled) ------
GEMINI_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
